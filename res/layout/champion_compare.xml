<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E7EBED">

    <!-- 상단 뒤로가기 버튼 -->
    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginTop="28dp"
        android:layout_marginStart="20dp"
        android:src="@drawable/ic_back"
        android:contentDescription="뒤로 가기"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- 챔피언 2명 + VS -->
    <LinearLayout
        android:id="@+id/compareTopContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="18dp"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 챔피언 1 -->
        <LinearLayout
            android:id="@+id/champion1Container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="4"
            android:orientation="vertical"
            android:gravity="center">

            <!-- 이미지+힌트 텍스트 -->
            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center">

                <ImageView
                    android:id="@+id/champion1Image"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/circle_background"
                    android:scaleType="centerCrop"/>

                <TextView
                    android:id="@+id/champion1ImageHint"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="챔피언 선택"
                    android:textColor="#80929F"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:background="@android:color/transparent"
                    android:visibility="visible"/>
            </FrameLayout>

            <!-- 이름 -->
            <TextView
                android:id="@+id/champion1Name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="챔피언"
                android:textStyle="bold"
                android:textColor="#25314C"
                android:textSize="15sp"
                android:gravity="center"/>

            <!-- 레벨 조정 -->
            <LinearLayout
                android:id="@+id/champion1LevelRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="2dp">

                <TextView
                    android:id="@+id/champion1LevelText"
                    android:layout_width="50dp"
                    android:layout_height="40dp"
                    android:text="Lv. 1"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:textColor="#25314C"/>

            </LinearLayout>

            <!-- 아이템 슬롯 -->
            <GridLayout
                android:id="@+id/champion1Items"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:rowCount="2"
                android:columnCount="3"
                android:alignmentMode="alignMargins"
                android:useDefaultMargins="true"
                android:layout_marginTop="2dp"
                android:layout_gravity="center"/>
        </LinearLayout>

        <!-- VS -->
        <TextView
            android:id="@+id/vsText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="VS"
            android:textStyle="bold"
            android:textColor="#80929F"
            android:textSize="24sp"
            android:gravity="center"
            android:padding="8dp"/>

        <!-- 챔피언 2 -->
        <LinearLayout
            android:id="@+id/champion2Container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="4"
            android:orientation="vertical"
            android:gravity="center">

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center">

                <ImageView
                    android:id="@+id/champion2Image"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/circle_background"
                    android:scaleType="centerCrop"/>

                <TextView
                    android:id="@+id/champion2ImageHint"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="챔피언 선택"
                    android:textColor="#80929F"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:background="@android:color/transparent"
                    android:visibility="visible"/>
            </FrameLayout>

            <TextView
                android:id="@+id/champion2Name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="챔피언"
                android:textStyle="bold"
                android:textColor="#25314C"
                android:textSize="15sp"
                android:gravity="center"/>

            <LinearLayout
                android:id="@+id/champion2LevelRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="2dp">

                <TextView
                    android:id="@+id/champion2LevelText"
                    android:layout_width="50dp"
                    android:layout_height="40dp"
                    android:text="Lv. 1"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:textColor="#25314C"/>

            </LinearLayout>

            <GridLayout
                android:id="@+id/champion2Items"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:rowCount="2"
                android:columnCount="3"
                android:alignmentMode="alignMargins"
                android:useDefaultMargins="true"
                android:layout_marginTop="2dp"
                android:layout_gravity="center"/>
        </LinearLayout>
    </LinearLayout>

    <!-- 능력치 비교 표 (스크롤 가능) -->
    <ScrollView
        android:id="@+id/compareStatsScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="18dp"
        app:layout_constraintTop_toBottomOf="@id/compareTopContainer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/compareStatsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="6dp"/>
        <!-- 아래에 동적으로 각 능력치 비교 줄이 들어감 -->
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
