<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- AlertDialog 스타일 -->
    <style name="CustomAlertDialog" parent="ThemeOverlay.AppCompat.Dialog.Alert">
        <item name="android:background">#E7EBED</item>
        <item name="buttonBarStyle">@style/CustomDialogButtonBar</item>
    </style>

    <!-- 버튼 영역 전체 배경까지 포함 -->
    <style name="CustomDialogButtonBar" parent="Widget.AppCompat.ButtonBar.AlertDialog">
        <item name="android:background">#E7EBED</item> <!-- 버튼 바 배경 -->
    </style>

    <!-- 버튼 자체 스타일 -->
    <style name="DialogButtonStyle" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">#000000</item>
        <item name="android:background">#E7EBED</item>
    </style>

</resources>
