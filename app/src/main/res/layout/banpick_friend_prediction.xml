<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#181828">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <Button
            android:id="@+id/PageBack"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="20dp"
            android:layout_gravity="left"
            android:background="@drawable/pageback_vector" />

        <TextView
            android:id="@+id/prediction_result"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="예상 승률"
            android:gravity="center"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFD700"
            android:layout_marginBottom="28dp"/>

        <TextView
            android:id="@+id/blue_team_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="블루팀"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#89B7FF"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"/>

        <TableLayout
            android:id="@+id/blue_table"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="4dp"
            android:layout_marginBottom="15dp"
            android:background="@drawable/rounded_bottom_corners2"/>

        <TextView
            android:id="@+id/red_team_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="레드팀"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#FF6B63"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"/>

        <TableLayout
            android:id="@+id/red_table"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="4dp"
            android:background="@drawable/rounded_bottom_corners3"
            android:layout_marginBottom="32dp"/>

        <Button
            android:id="@+id/btn_save_banpick"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:text="이 밴픽 결과 저장"
            android:textSize="12sp"
            android:backgroundTint="#67C1F5"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp"/>
    </LinearLayout>
</ScrollView>
