<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".BanPickMain">

    <Button
        android:id="@+id/PageBack"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="30dp"
        android:background="@drawable/pageback_vector"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/BanpickTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="롤 모의 밴픽 시뮬레이터"
        android:textStyle="bold"
        android:textSize="25dp"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <TextView
        android:id="@+id/banpick_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="혼자하기시에 아래 이름을 정해주세요."
        android:textSize="15dp"
        android:textColor="#868686"
        android:textStyle="bold"
        android:backgroundTint="#000000"
        android:layout_marginBottom="10dp"
        android:layout_marginTop="30dp"
        android:layout_marginStart="50dp"
        app:layout_constraintTop_toBottomOf="@+id/BanpickTitle"
        app:layout_constraintBottom_toTopOf="@+id/BlueTeam"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/BlueTeam"
        android:layout_width="75dp"
        android:layout_height="35dp"
        android:text="   블루팀"
        android:textSize="16dp"
        android:textColor="#FFFFFF"
        android:textStyle="normal"
        android:background="#0048FF"
        android:padding="5dp"
        android:layout_marginTop="50dp"
        android:layout_marginStart="50dp"
        app:layout_constraintTop_toBottomOf="@+id/BanpickTitle"
        app:layout_constraintStart_toStartOf="parent"/>

    <EditText
        android:id="@+id/BlueTeamName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:hint="블루팀 이름 설정하기"
        android:textSize="15dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#90FFFFFF"
        android:textStyle="normal"
        android:backgroundTint="#000000"
        android:layout_marginTop="-5dp"
        android:layout_marginStart="45dp"
        app:layout_constraintTop_toBottomOf="@+id/BlueTeam"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/RedTeam"
        android:layout_width="75dp"
        android:layout_height="35dp"
        android:text="   레드팀"
        android:textSize="16dp"
        android:padding="5dp"
        android:textColor="#FFFFFF"
        android:textStyle="normal"
        android:background="#FF1E00"
        android:layout_marginTop="20dp"
        android:layout_marginStart="50dp"
        app:layout_constraintTop_toBottomOf="@+id/BlueTeamName"
        app:layout_constraintStart_toStartOf="parent"/>

    <EditText
        android:id="@+id/RedTeamName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:hint="레드팀 이름 설정하기"
        android:textSize="15dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#90FFFFFF"
        android:textStyle="normal"
        android:backgroundTint="#000000"
        android:layout_marginTop="-5dp"
        android:layout_marginStart="45dp"
        app:layout_constraintTop_toBottomOf="@+id/RedTeam"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/TimeCheck"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="시간 설정"
        android:textSize="20dp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:backgroundTint="#000000"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@+id/RedTeamName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <RadioGroup
        android:id="@+id/TimeCheckBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/TimeCheck"
        android:layout_marginTop="5dp">

        <RadioButton
            android:id="@+id/TimeOn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" ON"
            android:textSize="20dp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:checked="true"/>

        <RadioButton
            android:id="@+id/TimeOFF"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" OFF"
            android:textSize="20dp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginStart="30dp"/>
    </RadioGroup>

    <Button
        android:id="@+id/BanPickStartBtn"
        android:layout_width="100dp"
        android:layout_height="45dp"
        android:text="혼자하기"
        android:textSize="13sp"
        android:textColor="#000000"
        android:textStyle="normal"
        android:backgroundTint="#E4E4E4"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="30dp"
        app:layout_constraintTop_toBottomOf="@+id/TimeCheckBtn"
        app:layout_constraintStart_toEndOf="@id/BanPick_Friend_StartBtn"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/BanPick_Friend_StartBtn"
        android:layout_width="100dp"
        android:layout_height="45dp"
        android:text="방 만들기"
        android:textSize="13sp"
        android:textColor="#000000"
        android:textStyle="normal"
        android:backgroundTint="#E4E4E4"
        android:layout_marginTop="10dp"
        android:layout_marginStart="30dp"
        app:layout_constraintTop_toBottomOf="@+id/TimeCheckBtn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/BanPickStartBtn"/>


    <TextView
        android:id="@+id/TimeCheck2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="방에 참가하려면 아래에 코드를 입력해주세요."
        android:textSize="12dp"
        android:textColor="#868686"
        android:textStyle="bold"
        android:backgroundTint="#000000"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toBottomOf="@+id/BanPick_Friend_StartBtn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <EditText
        android:id="@+id/etRoomCode"
        android:layout_width="170dp"
        android:layout_height="35dp"
        android:hint="    방 코드 입력"
        android:textSize="14sp"
        android:textColor="#868686"
        android:background="#FFFFFF"
        android:textStyle="bold"
        android:inputType="textCapCharacters"
        android:digits="ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="30dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/BanPick_Friend_GoBtn" />

    <Button
        android:id="@+id/BanPick_Friend_GoBtn"
        android:layout_width="80dp"
        android:layout_height="50dp"
        android:text="확인"
        android:textSize="14sp"
        android:textColor="#000000"
        android:textStyle="normal"
        android:backgroundTint="#E4E4E4"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="90dp"
        app:layout_constraintTop_toBottomOf="@+id/TimeCheck2"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>