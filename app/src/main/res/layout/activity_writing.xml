<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="0dp">

        <!-- 아래는 기존 코드 그대로! -->

        <!-- 1. 상단 바: 뒤로가기(왼쪽) - Spacer - 이미지(오른쪽) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="32dp"
            android:paddingBottom="12dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/imageView3"
                android:layout_width="37dp"
                android:layout_height="35dp"
                app:srcCompat="?attr/homeAsUpIndicator"
                android:contentDescription="뒤로가기"/>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="114dp"
                android:layout_height="88dp"
                android:background="@android:color/darker_gray"
                android:contentDescription="이미지를 추가하려면 클릭하세요"
                android:scaleType="centerCrop"/>
        </LinearLayout>

        <!-- 제목 입력 -->
        <EditText
            android:id="@+id/editText"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/rounded_scrollview"
            android:hint="제목을 입력하세요"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:maxLines="1"
            android:padding="10dp"
            android:textSize="18sp"/>

        <!-- 내용 입력 -->
        <EditText
            android:id="@+id/editTextContent"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:gravity="top"
            android:hint="내용을 적어주세요"
            android:inputType="textMultiLine"
            android:minHeight="150dp"
            android:scrollbars="vertical"
            android:textSize="16sp"
            android:background="@drawable/scrollview"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp"/>

        <!-- 해시태그 -->
        <TextView
            android:id="@+id/hashtagTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:padding="8dp"
            android:text="해시태그 추가"
            android:textColor="#888888"
            android:textSize="16sp"
            android:layout_gravity="end"/>

        <!-- 아이템 선택 버튼 -->
        <Button
            android:id="@+id/btnSelectItems"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="아이템 선택"
            android:backgroundTint="#B1C1CE"
            android:layout_gravity="center_horizontal"/>

        <!-- 선택된 아이템 표시 텍스트 -->
        <TextView
            android:id="@+id/textSelectedItems"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="아이템: 없음"
            android:textColor="@android:color/black"
            android:textSize="16sp"
            android:layout_marginTop="4dp"
            android:layout_gravity="center_horizontal"/>

        <!-- 아이템 이미지 컨테이너 -->
        <LinearLayout
            android:id="@+id/itemImageContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="8dp"/>

        <!-- 글쓰기/임시저장 버튼 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="32dp"
            android:paddingLeft="16dp"
            android:paddingRight="16dp">

            <Button
                android:id="@+id/button2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="#B1C1CE"
                android:text="임시저장"/>


            <View
                android:layout_width="16dp"
                android:layout_height="wrap_content"/>

            <Button
                android:id="@+id/button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="#B1C1CE"
                android:text="글 쓰 기"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
