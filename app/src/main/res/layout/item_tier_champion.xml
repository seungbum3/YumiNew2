<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:orientation="horizontal"
    android:padding="8dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/tvRank"
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        android:text="1"
        android:textSize="16sp"
        android:textColor="#000000"
        android:gravity="center" />

    <ImageView
        android:id="@+id/imgChampionIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="12dp"
        android:scaleType="centerCrop" />

    <!-- 이름에 weight="1"을 줘서 오른쪽으로 밀어줌 -->
    <TextView
        android:id="@+id/tvChampionName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:text="챔피언 이름"
        android:textSize="16sp"
        android:textColor="#000000" />

    <!-- 승률/픽률/밴률 -->
    <TextView
        android:id="@+id/tvWinRate"
        android:layout_width="54dp"
        android:layout_height="wrap_content"
        android:text="54.4%"
        android:textColor="#476EFF"
        android:textSize="13sp"
        android:gravity="center" />

    <TextView
        android:id="@+id/tvPickRate"
        android:layout_width="54dp"
        android:layout_height="wrap_content"
        android:text="5.21%"
        android:textColor="#23B700"
        android:textSize="13sp"
        android:gravity="center" />

    <TextView
        android:id="@+id/tvBanRate"
        android:layout_width="54dp"
        android:layout_height="wrap_content"
        android:text="1.8%"
        android:textColor="#FF003C"
        android:textSize="13sp"
        android:gravity="center" />
</LinearLayout>
