<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_background"
    tools:context=".ChampionTierVowelActivity">

    <!-- 🔙 뒤로 가기 버튼 -->
    <Button
        android:id="@+id/PageBack"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_marginStart="15dp"
        android:layout_marginTop="30dp"
        android:background="@drawable/pageback_vector"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- 역할 버튼들 (탑, 정글, 미드, 원딜, 서폿) -->
    <LinearLayout
        android:id="@+id/role_buttons_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_horizontal"
        android:layout_marginTop="70dp"
        android:paddingHorizontal="12dp"
        android:paddingBottom="8dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_top"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="탑"
            android:textSize="12sp"
            android:backgroundTint="@android:color/transparent"
            app:cornerRadius="0dp"
            app:strokeWidth="0dp"
            android:textColor="#9E9E9E" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_jungle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="정글"
            android:textSize="11sp"
            android:backgroundTint="@android:color/transparent"
            app:cornerRadius="0dp"
            app:strokeWidth="0dp"
            android:textColor="#9E9E9E" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_mid"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="미드"
            android:textSize="10sp"
            android:backgroundTint="@android:color/transparent"
            app:cornerRadius="0dp"
            app:strokeWidth="0dp"
            android:textColor="#9E9E9E" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_adc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="원딜"
            android:textSize="10sp"
            android:backgroundTint="@android:color/transparent"
            app:cornerRadius="0dp"
            app:strokeWidth="0dp"
            android:textColor="#9E9E9E" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_support"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="서폿"
            android:textSize="10sp"
            android:backgroundTint="@android:color/transparent"
            app:cornerRadius="0dp"
            app:strokeWidth="0dp"
            android:textColor="#9E9E9E" />
    </LinearLayout>

    <!-- 라인별 챔피언 리스트 표시용 RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/championTierRecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/role_buttons_container"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:clipToPadding="false"
        android:scrollbars="vertical" />

</androidx.constraintlayout.widget.ConstraintLayout>
