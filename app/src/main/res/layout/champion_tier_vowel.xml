<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E7EBED"
    tools:context=".ChampionTierVowelActivity">

    <!-- 🔙 뒤로 가기 버튼 -->
    <Button
        android:id="@+id/PageBack"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_marginStart="15dp"
        android:layout_marginTop="30dp"
        android:background="@drawable/pageback_vector"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="챔피언 빌드"
        android:textStyle="bold"
        android:textSize="18dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="30dp"/>

    <!-- 역할 버튼들 (탑, 정글, 미드, 원딜, 서폿) -->
    <LinearLayout
        android:id="@+id/role_buttons_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_horizontal"
        android:layout_marginTop="70dp"
        android:paddingHorizontal="12dp"
        android:paddingBottom="8dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_top"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.9"
            android:text="탑"
            android:textSize="12sp"
            android:backgroundTint="@android:color/transparent"
            app:cornerRadius="0dp"
            app:strokeWidth="0dp"
            android:textColor="#9E9E9E" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_jungle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="정글"
            android:textSize="10sp"
            android:backgroundTint="@android:color/transparent"
            app:cornerRadius="0dp"
            app:strokeWidth="0dp"
            android:textColor="#9E9E9E" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_mid"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="미드"
            android:textSize="10sp"
            android:backgroundTint="@android:color/transparent"
            app:cornerRadius="0dp"
            app:strokeWidth="0dp"
            android:textColor="#9E9E9E" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_adc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="원딜"
            android:textSize="10sp"
            android:backgroundTint="@android:color/transparent"
            app:cornerRadius="0dp"
            app:strokeWidth="0dp"
            android:textColor="#9E9E9E" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_support"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="서폿"
            android:textSize="10sp"
            android:backgroundTint="@android:color/transparent"
            app:cornerRadius="0dp"
            app:strokeWidth="0dp"
            android:textColor="#9E9E9E" />
    </LinearLayout>

    <!-- TableLayout 헤더 -->
    <TableLayout
        android:id="@+id/tableHeader"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        app:layout_constraintTop_toBottomOf="@id/role_buttons_container"
        android:layout_marginEnd="8dp"
        android:layout_marginStart="8dp"
        android:stretchColumns="1,2,3">

        <TableRow>
            <TextView
                android:layout_width="240dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text=""
                android:visibility="invisible"/>
            <TextView
                android:id="@+id/header_win"
                android:layout_width="54dp"
                android:layout_height="48dp"
                android:text="승률"
                android:textColor="#476EFF"
                android:textStyle="bold"
                android:textSize="13sp"
                android:gravity="center"
                android:textAlignment="center"
                android:layout_marginStart="8dp"/>
            <TextView
                android:id="@+id/header_pick"
                android:layout_width="54dp"
                android:layout_height="48dp"
                android:text="픽률"
                android:textColor="#23B700"
                android:textStyle="bold"
                android:textSize="13sp"
                android:gravity="center"
                android:textAlignment="center"/>
            <TextView
                android:id="@+id/header_ban"
                android:layout_width="54dp"
                android:layout_height="48dp"
                android:text="밴률"
                android:textColor="#FF003C"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginEnd="10dp"
                android:gravity="center"
                android:textAlignment="center"/>
        </TableRow>

    </TableLayout>

    <!-- 라인별 챔피언 리스트 표시용 RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/championTierRecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingTop="0dp"
        app:layout_constraintTop_toBottomOf="@id/tableHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:clipToPadding="false"
        android:scrollbars="vertical" />

</androidx.constraintlayout.widget.ConstraintLayout>