<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E7EBED">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="20dp">

            <ImageView
                android:id="@+id/imgChampionSplash"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />

            <Button
                android:id="@+id/btnBack"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/pageback_vector"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_marginTop="20dp"
                android:layout_margin="12dp" />

            <TextView
                android:id="@+id/tvChampionName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="이렐리아"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:padding="6dp"
                android:layout_alignParentBottom="true"
                android:layout_alignParentStart="true"
                android:layout_margin="8dp"/>
        </RelativeLayout>

        <!-- 스킬 아이콘 -->
        <LinearLayout
            android:id="@+id/skillLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="end|center_vertical"
            >

            <!-- 스킬 텍스트 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="스킬"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="5dp"
                android:layout_marginEnd="12dp" />  <!-- 🔥 텍스트와 이미지 사이 간격 12dp -->

            <!-- 스킬 아이콘 + P/Q/W/E/R 묶음 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- P -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:layout_marginEnd="4dp">

                    <ImageView
                        android:id="@+id/imgSkillP"
                        android:layout_width="30sp"
                        android:layout_height="30sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="P"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- Q -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:layout_marginEnd="4dp">

                    <ImageView
                        android:id="@+id/imgSkillQ"
                        android:layout_width="30sp"
                        android:layout_height="30sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Q"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- W -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:layout_marginEnd="4dp">

                    <ImageView
                        android:id="@+id/imgSkillW"
                        android:layout_width="30sp"
                        android:layout_height="30sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="W"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- E -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:layout_marginEnd="4dp">

                    <ImageView
                        android:id="@+id/imgSkillE"
                        android:layout_width="30sp"
                        android:layout_height="30sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="E"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- R -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <ImageView
                        android:id="@+id/imgSkillR"
                        android:layout_width="30sp"
                        android:layout_height="30sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="R"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>

        <!-- 룬 추천 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="룬 추천"
            android:textColor="#B41500"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="40dp" />

        <!-- 룬 섹션: 주 스타일 + 부 스타일 -->
        <LinearLayout
            android:id="@+id/layoutRunes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <!-- 주 스타일 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/tvPrimaryRune"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp" />

                <!-- 주 룬 4개 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <ImageView android:id="@+id/imgRune1" android:layout_width="35dp" android:layout_height="35dp" android:layout_marginEnd="4dp"/>
                    <ImageView android:id="@+id/imgRune2" android:layout_width="35dp" android:layout_height="35dp" android:layout_marginEnd="4dp"/>
                    <ImageView android:id="@+id/imgRune3" android:layout_width="35dp" android:layout_height="35dp" android:layout_marginEnd="4dp"/>
                    <ImageView android:id="@+id/imgRune4" android:layout_width="35dp" android:layout_height="35dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- 부 스타일 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/tvSubRune"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp" />

                <!-- 부 룬 2개 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <ImageView android:id="@+id/imgRune5" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginEnd="4dp"/>
                    <ImageView android:id="@+id/imgRune6" android:layout_width="40dp" android:layout_height="40dp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 소환사 주문 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="소환사 주문"
            android:textColor="#038133"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="40dp" />

        <LinearLayout
            android:id="@+id/summonerSpellLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginStart="10dp"
            android:layout_marginTop="8dp">

            <ImageView android:id="@+id/imgSpell1" android:layout_width="35dp" android:layout_height="35dp" android:layout_marginEnd="8dp"/>
            <ImageView android:id="@+id/imgSpell2" android:layout_width="35dp" android:layout_height="35dp"/>
        </LinearLayout>

        <!-- 🔹 섹션 타이틀 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="아이템 추천"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#007BB8"
            android:layout_gravity="center"
            android:layout_marginBottom="8dp" />

        <!-- 🔹 1렙 아이템 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="시작 아이템"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginStart="10dp"
            android:layout_marginTop="7dp">

            <ImageView android:id="@+id/imgStartAtk1" android:layout_width="35dp" android:layout_height="35dp" />
            <TextView android:text="+" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginHorizontal="4dp"
                android:textSize="12sp" android:layout_marginTop="6dp" android:textStyle="bold"/>
            <ImageView android:id="@+id/imgStartAtk2" android:layout_width="35dp" android:layout_height="35dp" />
        </LinearLayout>

        <!-- 🔹 신발 추천 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="신발"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="12dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginStart="10dp"
            android:layout_marginTop="4dp">

            <ImageView android:id="@+id/imgBoot1" android:layout_width="35dp" android:layout_height="35dp" />
        </LinearLayout>

        <!-- 🔹 핵심 아이템 빌드 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="핵심 아이템 빌드"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="12dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginStart="10dp"
            android:layout_marginTop="4dp">

            <ImageView android:id="@+id/imgCore1" android:layout_width="35dp" android:layout_height="35dp" />
            <TextView android:text="→" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginHorizontal="4dp"
                android:textSize="14sp" android:textStyle="bold" android:layout_marginTop="6dp"/>
            <ImageView android:id="@+id/imgCore2" android:layout_width="35dp" android:layout_height="35dp" />
            <TextView android:text="→" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginHorizontal="4dp"
                android:textSize="14sp" android:textStyle="bold" android:layout_marginTop="6dp"/>
            <ImageView android:id="@+id/imgCore3" android:layout_width="35dp" android:layout_height="35dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
