<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9F9F9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 챔피언 이미지 + 이름 -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="200dp">
            <ImageView
                android:id="@+id/imgChampionSplash"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:layout_alignParentStart="true"
                android:layout_alignParentEnd="true" />
            <Button
                android:id="@+id/btnBack"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/pageback_vector"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"/>
            <TextView
                android:id="@+id/tvChampionName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="이렐리아"
                android:textSize="20sp"
                android:textColor="@android:color/white"
                android:background="#80000000"
                android:padding="6dp"
                android:layout_alignParentBottom="true"
                android:layout_alignParentStart="true" />
        </RelativeLayout>

        <!-- 스킬 오더 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="스킬"
            android:textStyle="bold"
            android:layout_marginTop="12dp"/>
        <LinearLayout
            android:id="@+id/layoutSkills"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp" />

        <!-- 룬 추천 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="룬 추천"
            android:textStyle="bold"
            android:layout_marginTop="16dp"/>
        <ImageView
            android:id="@+id/imgRunes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:layout_marginTop="8dp" />

        <!-- 소환사 주문 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="소환사 주문"
            android:textStyle="bold"
            android:layout_marginTop="16dp"/>
        <LinearLayout
            android:id="@+id/layoutSpells"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp" />

        <!-- 아이템 추천 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="아이템 추천"
            android:textStyle="bold"
            android:layout_marginTop="16dp"/>
        <LinearLayout
            android:id="@+id/layoutItems"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="4dp" />

    </LinearLayout>
</ScrollView>
